# Opt-in Jetson AGX Orin development image. CUDA and the GPU driver come from the host.
# Node's Linux arm64 binaries run on Ubuntu 24.04; keep the default image unchanged.
FROM --platform=linux/arm64 node:24-bookworm-slim AS node
FROM --platform=linux/arm64 ubuntu:24.04

LABEL io.pi-docker.orin="1"
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl wget git jq ripgrep python3 python3-pip python3-venv \
    build-essential cmake ninja-build pkg-config make g++ binutils \
    sudo gosu bubblewrap socat util-linux libnuma1 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && printf 'ALL ALL=(root) NOPASSWD: ALL\n' > /etc/sudoers.d/pi-docker \
    && chmod 0440 /etc/sudoers.d/pi-docker
COPY --from=node /usr/local /usr/local
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent
COPY orin/entrypoint.sh /usr/local/bin/pi-docker-orin-entrypoint
COPY orin/validate.sh /usr/local/bin/pi-docker-orin-validate
RUN chmod 0755 /usr/local/bin/pi-docker-orin-*
ENV CUDA_HOME=/usr/local/cuda-13.2 \
    CUDAToolkit_ROOT=/usr/local/cuda-13.2 \
    PATH=/usr/local/cuda-13.2/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/usr/local/cuda-13.2/lib64
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/pi-docker-orin-entrypoint"]
